---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import Markup from "@/components/Markup.astro"

/**
 * One row of "Selected work" on the home page: the ordinal, the product, the
 * description, the scope, and a thumbnail in the last two columns.
 *
 * Wider and heavier than a `SystemRow` on purpose — the home page shows three
 * of these and the inventory shows thirteen, and the difference in weight is
 * what tells a visitor which list is the argument and which is the record.
 */
interface Props {
    index: number
    title: string
    /** The client context or, on a case study, its year and role line. */
    context?: string
    /** Description carrying the shared Typst markup subset. */
    description?: string
    /** The scope line, e.g. "Owned, from scratch". */
    scope?: string
    /** What it was specified against. */
    stack?: string
    href: string
    /** Thumbnail. Absent until the product has a published image. */
    cover?: ImageMetadata
    coverAlt?: string
    first?: boolean
    last?: boolean
}

const {
    index,
    title,
    context,
    description,
    scope,
    stack,
    href,
    cover,
    coverAlt,
    first = false,
    last = false,
}: Props = Astro.props

const ordinal = String(index).padStart(2, "0")
---

<a
    class:list={["work-item", "grid", first && "work-item--first", last && "work-item--last"]}
    href={href}
>
    <span class="work-item__index">{ordinal}</span>
    <span class="work-item__head">
        <span class="work-item__title">{title}</span>
        {context && <span class="work-item__context micro">{context}</span>}
    </span>
    {description && <Markup class="work-item__text" as="span" text={description} />}
    <span class="work-item__meta">
        {scope && <span class="micro micro--ink">{scope}</span>}
        {stack && <span class="work-item__stack">{stack}</span>}
    </span>
    <span class="work-item__thumb">
        {
            cover && (
                <Image
                    src={cover}
                    alt={coverAlt ?? ""}
                    widths={[320, 480, 640]}
                    sizes="(max-width: 64rem) 40vw, 16vw"
                    loading="lazy"
                />
            )
        }
    </span>
</a>
