---
import { getEntry } from "astro:content"
import { isWebVisible } from "@/lib/variants"

interface Props {
    /**
     * `full` is the invitation plus the contact list. `rule` is the colophon
     * alone, for a page that is already an ending — the 404.
     */
    variant?: "full" | "rule"
}

const { variant = "full" }: Props = Astro.props

const personal = await getEntry("personal", "personal")!
const site = await getEntry("site", "site")!
const { name, role, location } = personal.data
const { email, links } = personal.data.contact
const year = new Date().getFullYear()
---

<footer class:list={["site-footer", `site-footer--${variant}`]}>
    {
        variant === "full" && (
            <div class="site-footer__top grid pad">
                <div class="site-footer__invite">
                    <p class="site-footer__standfirst">{site.data.footer.standfirst}</p>
                    <a class="site-footer__cta" href={`mailto:${email}`}>
                        Start a conversation &rarr;
                    </a>
                </div>
                <dl class="site-footer__contact facts">
                    <div class="facts__row">
                        <dt>Email</dt>
                        <dd>
                            <a href={`mailto:${email}`}>{email}</a>
                        </dd>
                    </div>
                    {links.filter(isWebVisible).map((link) => (
                        <div class="facts__row">
                            <dt>{link.label}</dt>
                            <dd>
                                <a href={link.url} rel="me noopener">
                                    {link.display ?? link.url}
                                </a>
                            </dd>
                        </div>
                    ))}
                    <div class="facts__row">
                        <dt>Based in</dt>
                        <dd>{location}</dd>
                    </div>
                </dl>
            </div>
        )
    }
    <div class="site-footer__colophon pad">
        <p>&copy; {year} {name} &middot; {role}</p>
        <p>Set in Archivo</p>
    </div>
</footer>
