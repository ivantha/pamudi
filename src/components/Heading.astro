---
import type { Heading } from "@/content.config"

/**
 * A display heading with one phrase set in italic brass.
 *
 * Every title on the site goes through here, which is what keeps the accent a
 * single decision rather than a `<span>` typed out forty times. The accent may
 * be empty — a product whose name is one word takes the heading in ink.
 *
 * The space before the accent is added here rather than being carried as
 * trailing whitespace in the YAML, where it would be invisible and would not
 * survive a reformat.
 *
 * The markup below looks contorted and has to stay that way. A newline BETWEEN
 * two things inside the tag is a text node and renders as a space — that is how
 * a full stop ends up floating away from the word it belongs to, and it is why
 * the opening `>` and the closing `</Tag` hug the content. A newline INSIDE an
 * expression container, as Prettier has put one around `after`, is not a text
 * node and renders nothing; that one is safe. Change the shape and check a
 * title with a full stop after the accent, such as the home page's.
 */
interface Props {
    heading: Heading
    /** The element to render. Any heading level, or a `p` inside a section. */
    as?: "h1" | "h2" | "h3" | "p" | "span"
    /** `bright` is the brass accent; `ink` italicises without colouring. */
    tone?: "bright" | "ink"
    class?: string
}

const { heading, as: Tag = "p", tone = "bright", class: className }: Props = Astro.props
const { before, accent, after } = heading

const lead = before && accent ? `${before} ` : before
---

<Tag class={className}
    >{lead}{accent && <span class={tone === "bright" ? "accent-word" : "italic"}>{accent}</span>}{
        after
    }</Tag
>
