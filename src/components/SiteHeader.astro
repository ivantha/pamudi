---
import { getEntry } from "astro:content"
import { href } from "@/lib/url"

/**
 * Four links, the name, two links. The bar is symmetrical because the name is
 * the centre of the sheet rather than a logo pinned to a corner, and the two
 * halves are separate `<nav>` elements so the order a screen reader announces
 * matches the order the eye reads.
 */
const personal = await getEntry("personal", "personal")!
const { name } = personal.data
const path = Astro.url.pathname.replace(/\/$/, "")

const LEFT = [
    { label: "Home", path: "/" },
    { label: "Work", path: "/work" },
    { label: "Plates", path: "/plates" },
    { label: "Off hours", path: "/off-hours" },
]

const RIGHT = [
    { label: "Profile", path: "/profile" },
    { label: "Contact", path: "/contact", accent: true },
]

/**
 * True when `target` is the section being rendered.
 *
 * Case pages live under `/work/`, so they mark Work rather than leaving the bar
 * blank. The home page is matched exactly first, because every path starts with
 * the base. The CV page has no bar entry of its own and marks Profile, which is
 * the page that offers it.
 */
const isCurrent = (target: string) => {
    const t = href(target).replace(/\/$/, "")
    if (target === "/") return path === t
    if (target === "/profile") return path === t || path === href("/cv").replace(/\/$/, "")
    return path === t || path.startsWith(`${t}/`)
}
---

<header class="masthead">
    <nav class="masthead__nav" aria-label="Primary">
        {
            LEFT.map((item) => (
                <a
                    class="masthead__link"
                    href={href(item.path)}
                    aria-current={isCurrent(item.path) ? "page" : undefined}
                >
                    {item.label}
                </a>
            ))
        }
    </nav>
    <a class="masthead__mark" href={href("/")}>{name}</a>
    <nav class="masthead__nav masthead__nav--end" aria-label="Profile and contact">
        {
            RIGHT.map((item) => (
                <a
                    class:list={["masthead__link", item.accent && "masthead__link--accent"]}
                    href={href(item.path)}
                    aria-current={isCurrent(item.path) ? "page" : undefined}
                >
                    {item.label}
                </a>
            ))
        }
    </nav>
</header>
