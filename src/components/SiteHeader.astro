---
import { getEntry } from "astro:content"
import { href } from "@/lib/url"

const personal = await getEntry("personal", "personal")!
const { name, role, contact } = personal.data
const path = Astro.url.pathname.replace(/\/$/, "")

const NAV = [
    { label: "Work", path: "/" },
    { label: "Systems", path: "/systems" },
    { label: "About", path: "/about" },
    { label: "CV", path: "/cv" },
]

/**
 * True when `target` is the section being rendered.
 *
 * Case studies live under `/work/` and system detail pages under `/systems/`,
 * so both mark their parent rather than leaving the nav blank. The home page is
 * matched exactly first, because every path starts with the base.
 */
const isCurrent = (target: string) => {
    const t = href(target).replace(/\/$/, "")
    if (target === "/") return path === t || path.startsWith(`${t}/work`)
    return path === t || path.startsWith(`${t}/`)
}
---

<header class="site-header pad grid">
    <a class="site-header__mark" href={href("/")}>
        <span class="site-header__name">{name}</span>
        <span class="site-header__role">{role}</span>
    </a>
    <nav class="site-header__nav" aria-label="Primary">
        {
            NAV.map((item) => (
                <a
                    class="site-header__link"
                    href={href(item.path)}
                    aria-current={isCurrent(item.path) ? "page" : undefined}
                >
                    {item.label}
                </a>
            ))
        }
        <a class="site-header__contact" href={`mailto:${contact.email}`}>Contact</a>
    </nav>
</header>
