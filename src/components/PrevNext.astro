---
/**
 * The pair of links that closes a detail page: back to the list on the left,
 * on to the next entry on the right. Either side may be absent, and the layout
 * holds its columns when one is.
 */
interface Props {
    prev?: { href: string; label: string; title: string }
    next?: { href: string; label: string; title: string }
}

const { prev, next }: Props = Astro.props
---

<nav class="prev-next grid pad" aria-label="More work">
    {
        prev && (
            <a class="prev-next__link" href={prev.href}>
                <span class="micro">{prev.label}</span>
                <span class="prev-next__title">{prev.title}</span>
            </a>
        )
    }
    {
        next && (
            <a class="prev-next__link prev-next__link--next" href={next.href}>
                <span class="micro">{next.label}</span>
                <span class="prev-next__title">{next.title}</span>
            </a>
        )
    }
</nav>
