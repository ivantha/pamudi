---
import Markup from "@/components/Markup.astro"

/**
 * One row of the design-systems inventory: an ordinal, the product and its
 * industry context, the description, and what the engagement was specified
 * against.
 *
 * The row is the link to the product's own page, so the whole band is the
 * target rather than a title buried inside it.
 */
interface Props {
    /** Position in the whole inventory, not within its group. Zero-padded. */
    index: number
    /** The anonymised product name from `data/systems.yaml`. */
    product: string
    /** The industry context standing in for the client's name. */
    client?: string
    /** The project description, carrying the shared Typst markup subset. */
    description?: string
    /** What the engagement was: "Owned, from scratch", "Extended", and so on. */
    scope: string
    /** What the design was specified against. */
    stack: string
    /** Where the row leads. */
    href: string
    /** A system owned end to end; the ordinal takes the accent. */
    lead?: boolean
    /** First row in its group, which takes the ink rule above it. */
    first?: boolean
    /** Last row on the page, which closes with an ink rule below. */
    last?: boolean
}

const {
    index,
    product,
    client,
    description,
    scope,
    stack,
    href,
    lead = false,
    first = false,
    last = false,
}: Props = Astro.props

const ordinal = String(index).padStart(2, "0")
---

<a
    class:list={["system-row", "grid", first && "system-row--first", last && "system-row--last"]}
    href={href}
>
    <span class:list={["system-row__index", lead && "system-row__index--lead"]}>{ordinal}</span>
    <span class="system-row__head">
        <span class="system-row__title">{product}</span>
        {client && <span class="system-row__client micro">{client}</span>}
    </span>
    {description && <Markup class="system-row__text" as="span" text={description} />}
    <span class="system-row__meta">
        <span class="micro micro--ink">{scope}</span>
        <span class="system-row__stack">{stack}</span>
    </span>
</a>
