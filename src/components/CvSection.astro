---
/**
 * One labelled block on the About page: an italic display heading in a left
 * rail, the content beside it. Mirrors the CV's `sec()` component in
 * `cv/theme.typ`, so the page and the PDF read as one document.
 */
interface Props {
    /** Section heading, e.g. "Experience". */
    title: string
}

const { title } = Astro.props
---

<section class="cv-section">
    <h2 class="cv-section__title display">{title}</h2>
    <div class="cv-section__body"><slot /></div>
</section>
