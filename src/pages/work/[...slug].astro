---
import { getCollection, render } from "astro:content"
import { Image } from "astro:assets"
import Layout from "@/layouts/Layout.astro"
import Row from "@/components/Row.astro"
import { href } from "@/lib/url"

export async function getStaticPaths() {
    const work = await getCollection("work", ({ data }) => !data.draft)
    return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const { title, summary, year, role, context, disciplines, tools, cover, coverAlt } = entry.data

const FACTS = [
    ["Year", String(year)],
    ["Role", role],
    ["Context", context],
    ["Disciplines", disciplines.join(", ")],
    ...(tools.length > 0 ? [["Tools", tools.join(", ")] as const] : []),
] as const
---

<Layout title={title} description={summary}>
    <article>
        <div class="page-head">
            <div>
                <p class="eyebrow page-head__eyebrow">
                    <a href={href("/")}>Work</a><span class="page-head__sep">/</span>{year}
                </p>
                <h1 class="page-head__title">{title}</h1>
            </div>
            <p class="page-head__lede">{summary}</p>
        </div>

        <Row label="The brief" rule="strong">
            <dl class="case-facts">
                {
                    FACTS.map(([term, value]) => (
                        <>
                            <dt>{term}</dt>
                            <dd>{value}</dd>
                        </>
                    ))
                }
            </dl>
        </Row>

        <div class="case-cover">
            <Image
                src={cover}
                alt={coverAlt}
                widths={[640, 1024, 1600, 2048]}
                sizes="(min-width: 84rem) 71rem, 100vw"
                loading="eager"
            />
        </div>

        <Row label="The work" flush>
            <div class="prose"><Content /></div>
        </Row>
    </article>
</Layout>
