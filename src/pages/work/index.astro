---
import { Image } from "astro:assets"
import { getCollection, getEntry } from "astro:content"
import Layout from "@/layouts/Layout.astro"
import Heading from "@/components/Heading.astro"
import Process from "@/components/Process.astro"
import { href } from "@/lib/url"
import { systemSlug } from "@/lib/slug"
import { roman } from "@/lib/roman"
import { spell } from "@/lib/words"
import { isWebVisible } from "@/lib/variants"

// ── The freelance set ─────────────────────────────────────────────────────
//
// Four of the eight pieces published at /work/sodafresh, as a contact sheet
// that opens the page. Sodafresh is the one named client on this site: it is an
// independent engagement rather than an employer's client and its whole output
// is public advertising, so the anonymisation in data/experience.yaml was
// lifted on Oshan's explicit call, 2026-09-03. The thirteen products above are
// unaffected. Provenance and the frame-by-frame check are recorded in the
// header of src/pages/work/sodafresh.astro.
//
// Alt text lives here rather than in data/: it describes this crop at this
// size, which is a property of the page and not of the career record.
import bannerDoorSticker from "@/assets/soda-fresh/banner-door-sticker.jpg"
import instagramCampaign from "@/assets/soda-fresh/instagram-campaign.jpg"
import hoodies from "@/assets/soda-fresh/hoodies.png"
import priceSheet from "@/assets/soda-fresh/price-sheet.jpg"

const site = await getEntry("site", "site")!
const personal = await getEntry("personal", "personal")!
const systems = (await getCollection("systems")).filter(isWebVisible)
const pages = await getCollection("systemPages")

const COLLATERAL = [
    {
        src: bannerDoorSticker,
        alt: "Tall Sodafresh roll-up banner, the wordmark over a Home Soda Maker headline with a CO2 cylinder running its full height.",
        caption: "Roll-up banner",
        dark: false,
    },
    {
        src: instagramCampaign,
        alt: "Landscape campaign creative reading Show Us Your Soda Maker, boxed products scattered over curved bands of orange, pink and blue.",
        caption: "Campaign",
        dark: false,
    },
    {
        src: hoodies,
        alt: "Three hoodie mockups in white, pink and charcoal, each with a four-colour stripe band and the Sodafresh monogram.",
        caption: "Merchandise",
        dark: true,
    },
    {
        src: priceSheet,
        alt: "Distributor price sheet laying nine product bundles out in a three-by-three grid, each with its rupiah price on a cut corner.",
        caption: "Price sheet",
        dark: false,
    },
]

const work = site.data.work
const pageOf = new Map(pages.map((p) => [p.data.system, p.data]))

// The inventory the design counts is the client record: the one personal group
// project is not a client engagement and sits on the plates page instead, with
// the rest of her own work. `system-groups` in cv/common/loaders.typ draws the
// same line, by the same test on the same field.
const client = systems.filter((s) => s.data.scope !== "Personal project")
const owned = client.filter((s) => s.data.lead)
const rest = client.filter((s) => !s.data.lead)

// "Thirteen of twenty-four products". Both counts are derived so that adding a
// product cannot leave the eyebrow describing an inventory that no longer
// exists.
const designed = Number(personal.data.stats[0].value)
const eyebrow = `${work.eyebrow} · ${spell(client.length, true)} of ${spell(designed)} products`

// The two extended systems that carry screens sit above the list, because a
// row cannot hold a picture.
const plated = rest.filter((s) => pageOf.get(s.data.product)?.index)

// Only a product with a written page is a link, and it carries the arrow that
// says so. The rest are listed for the record. Their page still exists at the
// same URL and still carries the sourced facts — that rule has not changed —
// but a row that opens a page saying "nothing more is written here" is a
// promise the list should not make.
//
// The right-hand cell is the sourced scope plus the plate number where one
// exists. "Extended, 4 modules" becomes "Extended" once a plate number follows
// it, because the modules are stated on the page it opens.
const rows = rest.map((s) => {
    const page = pageOf.get(s.data.product)
    const base = s.data.scope.split(",")[0].trim()
    return {
        product: s.data.product,
        to: page ? `/work/${systemSlug(s.data.product)}` : null,
        scope: page?.plate ? `${base} · Plate ${roman(page.plate)}` : s.data.scope,
    }
})

// The list is a two-column grid filled row by row, so the rule that closes it
// belongs on the final pair rather than on the midpoint and the end.
const isLast = (i: number) => i >= rows.length - 2
---

<Layout
    title="Work"
    description="Three design systems owned from scratch and ten more extended, across agriculture, identity, logistics, banking, manufacturing and warehousing."
    current="/work"
>
    <section class="intro rule-bottom-ink" style="--intro-measure: 26ch">
        <p class="eyebrow">{eyebrow}</p>
        <Heading as="h1" class="display intro__title" heading={work.headline} />
        <p class="intro__lede">{work.lede}</p>
    </section>

    <section class="sec" id="owned">
        {
            owned.map((system) => {
                const page = pageOf.get(system.data.product)
                const index = page?.index
                const to = href(`/work/${systemSlug(system.data.product)}`)
                if (!index) return null
                return (
                    <article class="split owned">
                        <a
                            class:list={[
                                "plate",
                                "owned__plate",
                                index.shape === "tall"
                                    ? "owned__plate--tall"
                                    : "owned__plate--wide",
                                index.ground === "dark" && "plate--dark",
                            ]}
                            href={to}
                        >
                            <Image
                                src={index.src}
                                alt={index.alt}
                                widths={[480, 720, 1024, 1440]}
                                sizes="(max-width: 52rem) 90vw, 52vw"
                                loading="lazy"
                            />
                        </a>
                        <div>
                            <p class="micro">
                                {page.plate && <>Plate {roman(page.plate)} &nbsp;·&nbsp; </>}
                                {system.data.client}
                            </p>
                            <h2 class="owned__title">
                                <a href={to}>{system.data.product}</a>
                            </h2>
                            <p class="owned__text">{index.summary}</p>
                            <dl class="owned__facts">
                                {index.facts.map((fact) => (
                                    <>
                                        <dt>{fact.label}</dt>
                                        <dd>{fact.value}</dd>
                                    </>
                                ))}
                            </dl>
                            <a class="more owned__more" href={to}>
                                Read the case &rarr;
                            </a>
                        </div>
                    </article>
                )
            })
        }
    </section>

    <section class="sec rule-top-ink" id="inventory">
        <div class="sec-head">
            <h2 class="sec-title">{work.inventory.title}</h2>
            <p class="sec-note">{work.inventory.note}</p>
            <p class="micro sec-note">{work.inventory.aside}</p>
        </div>

        <div class="plated" style={`--plated: ${plated.length}`}>
            {
                plated.map((system) => {
                    const page = pageOf.get(system.data.product)!
                    const index = page.index!
                    return (
                        <figure class="plated__item">
                            <a
                                class="plated__link"
                                href={href(`/work/${systemSlug(system.data.product)}`)}
                            >
                                <span class="plate plated__plate">
                                    <Image
                                        src={index.src}
                                        alt={index.alt}
                                        widths={[320, 480, 720]}
                                        sizes="(max-width: 40rem) 80vw, 22rem"
                                        loading="lazy"
                                    />
                                </span>
                                <figcaption class="plated__caption">
                                    {page.plate && <>Plate {roman(page.plate)} &nbsp;·&nbsp; </>}
                                    {system.data.product} &nbsp;&rarr;
                                </figcaption>
                            </a>
                        </figure>
                    )
                })
            }
        </div>

        <div class="rows">
            {
                rows.map((row, i) => (
                    <div class:list={["row", isLast(i) && "row--last"]}>
                        {row.to ? (
                            <a class="row__name" href={href(row.to)}>
                                {row.product} &nbsp;&rarr;
                            </a>
                        ) : (
                            <span class="row__name">{row.product}</span>
                        )}
                        <span class="row__scope">{row.scope}</span>
                    </div>
                ))
            }
        </div>
    </section>

    <section class="sec rule-top-ink" id="freelance">
        <div class="sec-head">
            <h2 class="sec-title">{work.freelance.title}</h2>
            <p class="sec-note" style="max-width: 56ch">{work.freelance.note}</p>
        </div>

        <div class="collateral">
            {
                COLLATERAL.map((piece) => (
                    <figure class="collateral__item">
                        <a class="collateral__link" href={href("/work/sodafresh")}>
                            <span
                                class:list={[
                                    "plate",
                                    "collateral__plate",
                                    piece.dark && "plate--dark",
                                ]}
                            >
                                <Image
                                    src={piece.src}
                                    alt={piece.alt}
                                    widths={[240, 360, 480]}
                                    sizes="(max-width: 36rem) 44vw, (max-width: 64rem) 30vw, 22vw"
                                    loading="lazy"
                                />
                            </span>
                            <figcaption class="collateral__caption">{piece.caption}</figcaption>
                        </a>
                    </figure>
                ))
            }
        </div>

        <a class="more collateral__more" href={href("/work/sodafresh")}>
            {work.freelance.more} &rarr;
        </a>
    </section>

    <Process id="process" />
</Layout>
