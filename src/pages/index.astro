---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import { getCollection, getEntry } from "astro:content"
import Layout from "@/layouts/Layout.astro"
import Heading from "@/components/Heading.astro"
import { href } from "@/lib/url"
import { systemSlug } from "@/lib/slug"
import { roman } from "@/lib/roman"
import { careerSpan } from "@/lib/career"
import { isWebVisible, pickField } from "@/lib/variants"

// Plate I. The painting comes before any product screen on purpose: the page's
// argument is that the two hands are the same hand.
import fox from "@/assets/art/fox-digital.jpg"
import koi from "@/assets/art/koi-watercolour.jpg"

// The three screens the design picks out. Each is already published on its own
// product's page and was checked frame by frame before it was committed — see
// the provenance header on the matching file in src/content/systems/. The alt
// text is here rather than in `data/` because it describes this crop of this
// image, which is a property of the page and not of the career record.
import agriRoom from "@/assets/systems/precision-agriculture-app/room-dashboard.png"
import photoIdType from "@/assets/systems/photo-id/type-selection.png"
import wmsBatch from "@/assets/systems/warehouse-management-platform/batch-pick-items.png"

const PICK_ART: Record<string, { src: ImageMetadata; alt: string; dark?: boolean }> = {
    "Precision agriculture app": {
        src: agriRoom,
        alt: "Room dashboard on a dark ground: six coloured sensor chips above a six-line chart spanning three days.",
        dark: true,
    },
    "Photo-ID compliance app": {
        src: photoIdType,
        alt: 'Template picker headed "Select the Template Type", with tiles pairing a country flag and a passport name.',
    },
    "Warehouse management platform": {
        src: wmsBatch,
        alt: "Batch Pick item list on a handheld, a SKU header reading 00 of 40 items scanned and a Scan SKU ID field pinned at the foot.",
    },
}

const personal = await getEntry("personal", "personal")!
const site = await getEntry("site", "site")!
const experience = await getCollection("experience")
const pages = await getCollection("systemPages")
const { role, location, stats } = personal.data
const home = site.data.home

const city = location.split(",")[0].trim()
const span = careerSpan(experience.filter(isWebVisible).map((e) => e.data.dates))

// The website's third figure differs from the CV's. See data/personal.yaml.
const figures = stats.map((stat) => ({
    value: pickField(stat, "value") ?? stat.value,
    label: pickField(stat, "label") ?? stat.label,
}))

// Plate numbers live with the product they belong to, so a card cannot claim a
// numeral the case page does not print.
const plateOf = new Map(pages.map((p) => [p.data.system, p.data.plate]))

const picks = home.picks.items.map((item) => ({
    ...item,
    art: PICK_ART[item.system],
    plate: plateOf.get(item.system),
    to: item.to ?? `/work/${systemSlug(item.system)}`,
}))
---

<Layout current="/">
    <section class="hero">
        <p class="eyebrow">{role} &nbsp;·&nbsp; {city} &nbsp;·&nbsp; {span}</p>
        <Heading as="h1" class="display hero__title" heading={home.headline} />
        <p class="hero__lede">{home.lede}</p>
        <div class="btn-row btn-row--center">
            {
                home.actions.map((action) => (
                    <a class:list={["btn", `btn--${action.style}`]} href={href(action.to)}>
                        {action.label}
                    </a>
                ))
            }
        </div>
    </section>

    <figure class="hero__plate">
        <Image
            src={fox}
            alt="Digital painting of a red fox lying in long grass, the fur worked in fine strokes."
            widths={[640, 960, 1280, 1600]}
            sizes="(max-width: 85rem) 100vw, 1360px"
            loading="eager"
            fetchpriority="high"
        />
        <figcaption class="figcap figcap--three">
            <span>Plate {roman(1)}</span>
            <span>{home.plate.title}</span>
            <span class="figcap__note">{home.plate.note}</span>
        </figcaption>
    </figure>

    <section class="figures" aria-label="Headline figures">
        {
            figures.map((figure, i) => (
                <div class="figures__cell">
                    <p class:list={["figures__value", i === 1 && "figures__value--accent"]}>
                        {figure.value}
                    </p>
                    <p class="figures__label">{figure.label}</p>
                </div>
            ))
        }
    </section>

    <section class="sec sec--lg">
        <Heading
            as="h2"
            class="display sec-title sec-title--lg sec-head"
            heading={home.picks.title}
            tone="ink"
        />
        <div class="picks">
            {
                picks.map((pick, i) => (
                    <a class="pick" href={href(pick.to)}>
                        <span class:list={["plate", "pick__plate", pick.art.dark && "plate--dark"]}>
                            <Image
                                src={pick.art.src}
                                alt={pick.art.alt}
                                widths={[320, 480, 640, 900]}
                                sizes="(max-width: 60rem) 90vw, 28vw"
                                loading={i === 0 ? "eager" : "lazy"}
                            />
                        </span>
                        <span class="pick__eyebrow">
                            {pick.plate && <>Plate {roman(pick.plate)} &nbsp;·&nbsp; </>}
                            {pick.system}
                        </span>
                        <span class="display pick__title">{pick.title}</span>
                        <span class="pick__text">{pick.text}</span>
                        <span class="pick__more">{pick.more}</span>
                    </a>
                ))
            }
        </div>
        <p class="picks__note">
            {home.picks.note_before}{" "}
            <a href={href("/work")}>{home.picks.note_link}</a>.
        </p>
    </section>

    <section class="sec split teaser rule-top-ink">
        <div class="teaser__body">
            <Heading as="h2" class="display teaser__title" heading={home.plates.title} tone="ink" />
            <p class="teaser__text">{home.plates.text}</p>
            <a class="more teaser__more" href={href("/plates")}>{home.plates.more}</a>
        </div>
        <figure class="teaser__figure">
            <Image
                src={koi}
                alt="Watercolour study of two koi carp turning through pale water."
                widths={[320, 480, 640, 900]}
                sizes="(max-width: 52rem) 90vw, 34vw"
                loading="lazy"
            />
            <figcaption class="figcap">
                <strong>Koi</strong>
                <span>Watercolour</span>
            </figcaption>
        </figure>
    </section>

    <section class="sec sec--lg statement rule-top">
        <p class="eyebrow">{home.profile.label}</p>
        <p class="statement__text">{home.profile.text}</p>
        <a class="more statement__more" href={href("/profile")}>{home.profile.more}</a>
    </section>
</Layout>
