---
import { getCollection, getEntry } from "astro:content"
import Layout from "@/layouts/Layout.astro"
import Section from "@/components/Section.astro"
import WorkItem from "@/components/WorkItem.astro"
import Markup from "@/components/Markup.astro"
import { href } from "@/lib/url"
import { isWebVisible } from "@/lib/variants"
import { systemSlug } from "@/lib/slug"

const personal = await getEntry("personal", "personal")!
const site = await getEntry("site", "site")!
const education = await getEntry("education", "education")!
const community = await getEntry("community", "community")!
const { headline, intro, role, location, availability, stats, summary, contact } = personal.data

// `order` is the editorial sequence; year only breaks ties so that adding a
// study without setting `order` still lands somewhere sensible.
const work = (await getCollection("work", ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
)

// Until the case studies exist, the work section carries the three systems she
// built from scratch and owned end to end. Same file the inventory reads, so
// the two cannot drift, and it means the page never stands empty.
const systems = (await getCollection("systems")).filter((s) => isWebVisible(s.data))
const led = systems.filter((s) => s.data.lead)

const skills = (await getCollection("skills")).filter((s) => isWebVisible(s.data))
const experience = (await getCollection("experience")).filter((e) => isWebVisible(e.data))

// The hero lede, in order of provenance: her own `intro` when she writes one,
// then the design's line, then the Profile paragraph the CV prints. Every rung
// is real copy — see data/site.yaml and CLAUDE.md, "Whose site this is".
const lede = intro ?? [site.data.home.lede]

// Derived rather than written down, so neither can drift from the record. The
// earliest year across every role, not the last entry's — the list is ordered
// newest-first by seniority, and the freelance work that sorts last began in
// 2020, well after the career did.
const startYear = Math.min(
    ...experience.map((e) => Number(e.data.dates.match(/\b(19|20)\d{2}\b/)?.[0] ?? Infinity)),
)
const thisYear = new Date().getFullYear()

const msc = education.data.entries.find((e) => e.degree.startsWith("MSc"))

// The three community rows the home page previews. The full record, and the
// counts beside it, live on About; these are the most recent of each kind.
const recent = [...community.data.mentoring, ...community.data.speaking]
    .filter((row) => isWebVisible(row))
    .sort((a, b) => b.year.localeCompare(a.year))
    .slice(0, 3)

const counts = [
    { value: community.data.mentoring.filter(isWebVisible).length, label: "Mentoring engagements" },
    { value: community.data.speaking.filter(isWebVisible).length, label: "Talks and workshops" },
    { value: community.data.events.filter(isWebVisible).length, label: "Event and brand work" },
]
---

<Layout>
    <section class="hero pad sec sec--ink">
        <div class="hero__meta">
            <span>Portfolio</span>
            <span>{startYear} &mdash; {thisYear}</span>
            <span>{location}</span>
            {availability && <span class="hero__meta-accent">{availability}</span>}
        </div>
        <h1 class="hero__headline rise">
            {headline.before}{" "}
            <span class="hero__accent">{headline.accent}</span>{" "}
            {headline.after}
        </h1>
        <div class="hero__foot grid">
            <div class="hero__lede rise" style="--i: 1">
                {lede.map((p) => <Markup as="p" text={p} />)}
            </div>
            <dl class="hero__facts facts rise" style="--i: 2">
                <div class="facts__row">
                    <dt>Currently</dt>
                    <dd>{role}, {experience[0]?.data.org}</dd>
                </div>
                <div class="facts__row">
                    <dt>Focus</dt>
                    <dd>{personal.data.specialisms.join(" · ")}</dd>
                </div>
                {
                    msc && (
                        <div class="facts__row">
                            <dt>Education</dt>
                            <dd>
                                {msc.degree}, {msc.institute}
                            </dd>
                        </div>
                    )
                }
                <div class="facts__row">
                    <dt>Elsewhere</dt>
                    <dd class="hero__links">
                        <a href={`mailto:${contact.email}`}>Email</a>
                        {
                            contact.links.filter(isWebVisible).map((l) => (
                                <a href={l.url} rel="me noopener">
                                    {l.label}
                                </a>
                            ))
                        }
                    </dd>
                </div>
            </dl>
        </div>
    </section>

    <section class="stats" aria-label="Headline figures">
        {
            stats.map((stat) => (
                <div class="stats__cell">
                    <p class="stats__label">{stat.label}</p>
                    <p class="stats__value">{stat.value}</p>
                </div>
            ))
        }
    </section>

    <!-- Second-order counts: each is drawn from an experience bullet rather
         than being a headline claim, which is why they run as one line. -->
    <p class="figures pad">
        {
            site.data.home.figures.map((f, i) => (
                <span class="figures__item">
                    {i > 0 && <span class="figures__sep" aria-hidden="true" />}
                    <b>{f.value}</b> {f.label}
                </span>
            ))
        }
    </p>

    <Section label="Profile">
        <Markup as="p" class="profile" text={summary} />
    </Section>

    <Section label="Practice" note="What the work is" body="wide">
        <div class="practice">
            {
                site.data.practice.map((card) => (
                    <div class="practice__card">
                        <p class="micro">{card.label}</p>
                        <h3 class="practice__title">{card.title}</h3>
                        <Markup as="p" class="text" text={card.text} />
                    </div>
                ))
            }
        </div>
    </Section>

    <section class="selected pad">
        <div class="selected__head grid">
            <p class="label">Selected work</p>
            <p class="selected__lede">
                {
                    work.length > 0
                        ? "Case studies, in the order they are worth reading."
                        : "Three systems owned end to end, from the first token to the shipped screen."
                }
            </p>
            <p class="selected__count micro">
                {work.length > 0 ? work.length : led.length} / {systems.length}
            </p>
        </div>
        {
            work.length > 0
                ? work.map((entry, i) => (
                      <WorkItem
                          index={i + 1}
                          title={entry.data.title}
                          context={entry.data.context}
                          description={entry.data.summary}
                          scope={entry.data.role}
                          stack={entry.data.tools.join(" · ")}
                          href={href(`/work/${entry.id}`)}
                          cover={entry.data.cover}
                          coverAlt={entry.data.coverAlt}
                          first={i === 0}
                          last={i === work.length - 1}
                      />
                  ))
                : led.map((entry, i) => (
                      <WorkItem
                          index={i + 1}
                          title={entry.data.product}
                          context={entry.data.client}
                          description={entry.data.description}
                          scope={entry.data.scope}
                          stack={entry.data.stack}
                          href={href(`/systems/${systemSlug(entry.data.product)}`)}
                          first={i === 0}
                          last={i === led.length - 1}
                      />
                  ))
        }
        <p class="selected__more">
            {systems.length - led.length} further products, with the scope and stack each was specified
            for, are <a href={href("/systems")}>in the systems inventory</a>.
        </p>
    </section>

    <section class="band process">
        <div class="grid pad process__head">
            <p class="label process__label">How it runs</p>
            <p class="process__lede">{site.data.process.lede}</p>
        </div>
        <ol class="process__steps pad">
            {
                site.data.process.steps.map((step, i) => (
                    <li class="process__step">
                        <span class="process__num">{String(i + 1).padStart(2, "0")}</span>
                        <h3 class="process__title">{step.title}</h3>
                        <Markup as="p" class="process__text" text={step.text} />
                    </li>
                ))
            }
        </ol>
    </section>

    <Section label="Toolkit" note="What it is built with">
        <div class="toolkit">
            {
                skills.map((skill) => (
                    <div class="toolkit__row">
                        <h3 class="micro micro--ink">{skill.data.category}</h3>
                        <Markup as="p" class="text" text={skill.data.stack} />
                    </div>
                ))
            }
        </div>
    </Section>

    <Section label="Beyond the desk" rule="none">
        <div class="counts">
            {
                counts.map((c) => (
                    <div>
                        <p class="micro">{c.label}</p>
                        <p class="counts__value">{c.value}</p>
                    </div>
                ))
            }
        </div>
        <div class="dated-list">
            {
                recent.map((row) => (
                    <div class="dated">
                        <span class="dated__year">{row.year}</span>
                        <Markup as="p" text={row.text} />
                    </div>
                ))
            }
        </div>
        <p class="selected__more">
            The full record of speaking, mentoring, events and judging is <a href={href("/about")}
                >on the About page</a
            >.
        </p>
    </Section>
</Layout>
