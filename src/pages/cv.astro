---
import type { ImageMetadata } from "astro"
import { Image, getImage } from "astro:assets"
import { getEntry } from "astro:content"
import Layout from "@/layouts/Layout.astro"
import { href } from "@/lib/url"

const personal = await getEntry("personal", "personal")!
const site = await getEntry("site", "site")!
const { name, role } = personal.data

// The page renders come out of cv/build.sh, from the same Typst compile as the
// PDF, so the sheets below and the download can never be different documents.
// A glob rather than two named imports: build.sh asserts the page count, and if
// that ever legitimately changes the page should follow it without an edit.
const modules = import.meta.glob<{ default: ImageMetadata }>("../assets/cv/page-*.png", {
    eager: true,
})
const sheets = Object.entries(modules)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, module]) => module.default)

if (sheets.length === 0) {
    // Shipping this page with no CV on it would be worse than failing here.
    throw new Error(
        "No CV page renders in src/assets/cv/. Run `pnpm build:cv`; `pnpm dev` and `pnpm build` both do it for you.",
    )
}

// Each sheet at its own full size, for the link the figure below wraps around.
// On a phone the rendered sheet is about 335px wide, which puts the CV's 9pt
// body type at roughly 3px: legible as a picture of a document, not as a
// document. Tapping one opens the render at 1323px, where it can be
// pinch-zoomed, and the PDF download above stays the primary route.
//
// `getImage` rather than the raw `ImageMetadata.src`, so the target is a URL
// the build is guaranteed to have emitted.
const fullSheets = await Promise.all(
    sheets.map((sheet) => getImage({ src: sheet, width: sheet.width, format: "png" })),
)

// What each sheet actually carries, so the alt text describes the page rather
// than announcing that an image exists.
const CONTENTS = ["profile and experience", "design systems, toolkit, education and community"]

// The PDF is rebuilt on every `pnpm build`, so "updated" is the build date
// rather than a string somebody has to remember to bump.
const updated = new Date().toLocaleDateString("en-GB", { month: "long", year: "numeric" })

// The contents list reads down its two columns, not across, so an eye following
// 01, 02, 03 stays in the left one. That is a column-flow grid rather than a
// reordered array: the list stays in document order, which is what a screen
// reader announces and what the single-column phone layout shows.
const contents = site.data.cv.contents
const rows = Math.ceil(contents.length / 2)
---

<Layout
    title="Curriculum vitae"
    description={`The two-page curriculum vitae of ${name}, ${role}, as a PDF and on the page.`}
    current="/profile"
>
    <section class="intro rule-bottom-ink" style="--intro-measure: 20ch">
        <p class="eyebrow">{site.data.cv.eyebrow} &nbsp;·&nbsp; Updated {updated}</p>
        <h1 class="display intro__title">{site.data.cv.title}</h1>
        <div class="btn-row btn-row--center">
            <a class="btn btn--solid" href={href("/cv/cv.pdf")}>Download PDF &darr;</a>
        </div>
    </section>

    <section class="sec">
        <div class="sec-head">
            <h2 class="sec-title">What is in it</h2>
        </div>
        <ol class="cv-contents" style={`--rows: ${rows}`}>
            {
                contents.map((text, i) => (
                    <li>
                        <span class="cv-contents__num">{String(i + 1).padStart(2, "0")}</span>
                        <span>{text}</span>
                    </li>
                ))
            }
        </ol>
        <p class="cv-note">
            The site carries the longer record: the earlier degree projects, student event work and
            societies are <a href={href("/profile#record")}>on the profile</a> only, and the full inventory
            is <a href={href("/work#inventory")}>on the work index</a>.
        </p>
    </section>

    {
        /* The PDF is still the Cormorant-and-green document the site wore before
        this direction: the Plinth design carries no CV artboard. Whether to
        bring it across is a decision for Pamudi, not a tidy-up. */
    }
    <div class="cv-spread">
        {
            sheets.map((sheet, i) => (
                <figure class="cv-sheet">
                    <a
                        class="cv-sheet__open"
                        href={fullSheets[i].src}
                        aria-label={`Open page ${i + 1} of the curriculum vitae at full size`}
                    >
                        <Image
                            src={sheet}
                            alt={`Page ${i + 1} of the curriculum vitae: ${CONTENTS[i] ?? "further detail"}.`}
                            widths={[480, 640, 900, 1280, 1720]}
                            sizes="(min-width: 60rem) 54rem, 100vw"
                            loading={i === 0 ? "eager" : "lazy"}
                        />
                    </a>
                    <figcaption class="cv-sheet__folio">
                        Page {String(i + 1).padStart(2, "0")} /{" "}
                        {String(sheets.length).padStart(2, "0")}
                    </figcaption>
                </figure>
            ))
        }
    </div>
</Layout>
