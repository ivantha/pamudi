---
import { getCollection, getEntry } from "astro:content"
import Layout from "@/layouts/Layout.astro"
import PageHead from "@/components/PageHead.astro"
import SystemRow from "@/components/SystemRow.astro"
import { href } from "@/lib/url"
import { isWebVisible } from "@/lib/variants"
import { groupSystems } from "@/lib/systems"
import { systemSlug } from "@/lib/slug"

const site = await getEntry("site", "site")!
const systems = (await getCollection("systems")).filter((s) => isWebVisible(s.data))
const groups = groupSystems(systems)
const led = systems.filter((s) => s.data.lead)

// The ordinal runs across the whole inventory rather than restarting inside
// each group, so a row's number is a stable way to refer to it.
let ordinal = 0
const lastGroup = groups.at(-1)
---

<Layout
    title="Design systems"
    description={`The design-systems inventory: ${systems.length} client and in-house products, grouped by what the engagement was.`}
>
    <PageHead
        eyebrow={`Inventory / ${systems.length} products`}
        title="Design systems"
        lede={site.data.pages.systems}
    />

    <div class="inventory pad">
        {
            groups.map((group) => (
                <>
                    <div class="inventory__head grid">
                        <h2 class="label">{group.label}</h2>
                        {group.note && <p class="inventory__note">{group.note}</p>}
                        <p class="inventory__count micro">{group.rows.length}</p>
                    </div>
                    {group.rows.map((row, i) => {
                        ordinal += 1
                        return (
                            <SystemRow
                                index={ordinal}
                                product={row.data.product}
                                client={row.data.client}
                                description={row.data.description}
                                scope={row.data.scope}
                                stack={row.data.stack}
                                href={href(`/systems/${systemSlug(row.data.product)}`)}
                                lead={row.data.lead}
                                first={i === 0}
                                last={group === lastGroup && i === group.rows.length - 1}
                            />
                        )
                    })}
                </>
            ))
        }
        <p class="inventory__foot">
            The {led.length} systems owned end to end are set out on <a href={href("/")}
                >the work page</a
            >; the roles behind them are <a href={href("/about")}>on About</a>.
        </p>
    </div>
</Layout>
