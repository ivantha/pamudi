# build output
dist/
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
pnpm-debug.log*

# environment
.env
.env.production

# macOS
.DS_Store

# scratch
tmp/

# CV build proofs — regenerate with cv/build.sh --preview
cv/preview-*.png

# CV PDFs are built into public/ at build time, never committed
public/cv/

# CV page renders for the /cv page, written by cv/build.sh from the same
# compile as the PDF. Build artefacts, not sources — `pnpm dev` and `pnpm build`
# both run build:cv first, so they are always present when Astro needs them.
src/assets/cv/

# Private contact overlay — real phone number, never tracked
data/private.yaml

# Career knowledge base — the provenance behind data/*.yaml. Untracked because
# this repo is public and the record carries real client names (some possibly
# under NDA), an employer's internal appraisal detail, third-party colleague
# names and her phone number. kb/README.md is the one tracked file: a signpost
# that names nothing. `kb/*` not `kb/` — git will not descend into an ignored
# directory, so the negation below would never be reached.
kb/*
!kb/README.md
